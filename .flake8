[flake8]
select = WPS
ignore = WPS230, WPS608
max-local-variables = 6
max-cognitive-score = 13

per-file-ignores =
     test/__main__.py: WPS201
     test/*: WPS432, WPS226, WPS204, WPS213, WPS214
     reditools/tools/analyze/parse_args/arg_groups/*: WPS432, WPS226
     reditools/constants.py: WPS226
